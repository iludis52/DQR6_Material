        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Mortalitätssalienz (und damit verbunden auch Terrorsalienz) lösen Investitionen in kulturelle Werte sowie den Selbsterhalt aus, um dadurch indirekt nach Unsterblichkeit zu streben. Dies wird auch als »worldview defense« bezeichnet.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 3,
