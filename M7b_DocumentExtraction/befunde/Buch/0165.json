        ],
        [
          457.0,
          1552.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Religion ist grundlegend für viele kulturelle Glaubenssätze (Wertevermittlung, Leben nach dem Tod etc.). Daher kann sie Schutz bieten im Umgang mit Ängsten vor dem eigenen Tod.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
