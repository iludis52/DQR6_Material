        ],
        [
          1056.0,
          610.0
        ],
        [
          1380.0,
          610.0
        ],
        [
          1380.0,
          384.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Die meisten Studien zu Religiosität und Coping sind korrelativer Art und beziehen sich oft nur auf Einzelpersonen. Belastende äußere Situationen, die dagegen eine Vielzahl an Menschen betreffen, können politische Umstände, wie etwa Krieg oder Terrorismus sein.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
