      "quelle": "pp_doclayout",
      "text": "10.2 Bewältigung kollektiver Bedrohungen und Religion: Terrorismus als Spezialfall belastender Lebensumstände – Dient auch hier Religiosität als Resilienzfaktor?",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 5,
      "query_id": 2,
      "pp_label": "text",
      "score": 0.9681059718132019,
      "bbox": {
        "x0": 110.00456237792969,
        "y0": 1049.1373291015625,
        "x1": 1013.1409912109375,
        "y1": 1513.3719482421875,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 171,
      "polygon": [
        [
          110.0,
          1060.0
        ],
        [
          118.0,
          1512.0
        ],
        [
          1012.0,
