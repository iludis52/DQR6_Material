        ],
        [
          1012.0,
          1782.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Es stellt sich die Frage, ob intrinsische Religiosität auch im Kontext von Terrorismus-gefahr – und somit unter massiven äußeren Belastungen, die mit Todesgefahr verbunden sind – einen schützenden Faktor darstellt. Die meisten Studien hierzu sind aus dem amerikanischen Raum, korrelativer Art und Terrorismus wird häufig nur als eine von vielen Variablen erfasst. Ai und Peterson (2004) fanden bei Flüchtlingen aus",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 9,
      "query_id": 10,
      "pp_label": "text",
      "score": 0.9156331419944763,
      "bbox": {
        "x0": 1056.5435791015625,
        "y0": 384.8719482421875,
        "x1": 1381.85693359375,
        "y1": 611.5303955078125,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 265,
      "polygon": [
