      "quelle": "pp_doclayout",
      "text": "Die Forschung zum Stereotype-Threat-Effekt untersucht die Auswirkung von Stereotypen auf Personen, die stereotypisiert werden.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
