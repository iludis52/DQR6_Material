      "quelle": "pp_doclayout",
      "text": "Sozialer Einfluss ist ein vielschichtiges Phänomen, das in vielen sozialen Situationen zum Tragen kommt.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
