    {
      "id": 5,
      "query_id": 2,
      "pp_label": "text",
      "score": 0.9324856996536255,
      "bbox": {
        "x0": 150.85617065429688,
        "y0": 414.06927490234375,
        "x1": 1382.56396484375,
        "y1": 983.6196899414062,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
