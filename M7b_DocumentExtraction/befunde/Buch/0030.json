    {
      "id": 8,
      "query_id": 3,
      "pp_label": "text",
      "score": 0.5266191363334656,
      "bbox": {
        "x0": 148.8048095703125,
        "y0": 536.0581665039062,
        "x1": 1381.8385009765625,
        "y1": 851.0681762695312,
