    },
    {
      "id": 6,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9620271325111389,
      "bbox": {
        "x0": 504.13153076171875,
        "y0": 182.87869262695312,
        "x1": 1405.7694091796875,
        "y1": 517.506103515625,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
