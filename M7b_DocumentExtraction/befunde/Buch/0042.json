        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Wie funktioniert die Verfügbarkeitsheuristik und wann wird sie verwendet? Sehr verallgemeinert kann man erwarten, dass diejenigen Ereignisse oder Dinge, die häufig auftreten, auch häufiger im Gedächtnis haften bleiben. Aus eigener Erfahrung weiß z. B. jede autofahrende Person, dass ein Mercedes häufiger auf den Straßen zu sehen ist als ein Maserati.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 13,
      "query_id": 4,
      "pp_label": "text",
      "score": 0.9605914950370789,
      "bbox": {
        "x0": 503.5428161621094,
