      "quelle": "pp_doclayout",
      "text": "Systematische Fehler bei der Vermittlung bzw. Speicherung von Informationen können zu Urteilsverzerrungen bei der Einschätzung von Wahrscheinlichkeiten führen.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
