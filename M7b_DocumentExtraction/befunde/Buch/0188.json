      "bbox": {
        "x0": 110.20651245117188,
        "y0": 582.7822265625,
        "x1": 1013.4925537109375,
        "y1": 881.4627685546875,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 100,
      "polygon": [
