        ],
        [
          1365.0,
          584.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Grundsätzlich kann die Reduktion von Frustrationsstimuli in allen Bereichen der Gesellschaft als wirksamer Mechanismus zur Reduktion von Aggression betrachtet werden.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
