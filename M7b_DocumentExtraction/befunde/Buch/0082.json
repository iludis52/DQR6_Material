    {
      "id": 5,
      "query_id": 6,
      "pp_label": "text",
      "score": 0.8252769708633423,
      "bbox": {
        "x0": 149.66891479492188,
        "y0": 250.33346557617188,
        "x1": 1371.3968505859375,
        "y1": 518.966552734375,
        "rahmen": "bild_pixel",
