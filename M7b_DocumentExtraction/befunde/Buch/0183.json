          452.0,
          1823.0
        ],
        [
          452.0,
          1685.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Auf gesamtgesellschaftlicher Ebene kann die Überbevölkerung als Nutzungsdilemma aufgefasst werden. Kinderreichtum ist dabei kooperativ oder desertierend, je nach gesellschaftlichem Zusammenhang.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 10,
      "query_id": 3,
      "pp_label": "text",
      "score": 0.9554435014724731,
      "bbox": {
        "x0": 503.416748046875,
        "y0": 1181.913330078125,
        "x1": 1407.0706787109375,
        "y1": 1381.146240234375,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 212,
      "polygon": [
