          451.0,
          1185.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Verhalten sich alle Individuen beim Verbrauch gemeinschaftlicher Güter egoistisch, so kommt es zu einem Zusammenbruch der Ressource.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 9,
      "query_id": 15,
      "pp_label": "text",
      "score": 0.8161224722862244,
      "bbox": {
        "x0": 127.64322662353516,
        "y0": 1685.015869140625,
        "x1": 453.4585266113281,
        "y1": 1855.984619140625,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 201,
      "polygon": [
        [
          127.0,
          1685.0
        ],
        [
          127.0,
