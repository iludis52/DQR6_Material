        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Eine andere Richtung sozialpsychologischer Religionsforschung stellt das Verhalten des Individuums in Gemeinschaft mit anderen in den Vordergrund.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 3,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9727546572685242,
