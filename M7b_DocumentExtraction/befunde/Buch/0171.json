        "x0": 503.5020446777344,
        "y0": 183.27908325195312,
        "x1": 1406.40478515625,
        "y1": 647.4710693359375,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 110,
      "polygon": [
        [
          503.0,
          183.0
        ],
        [
          503.0,
