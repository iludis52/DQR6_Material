      "quelle": "pp_doclayout",
      "text": "Religion ist mehrdimensional und wird mit der Unterteilung in extrinsi- sche und intrinsische Religiosität nicht vollständig erfasst. Auch sind kulturelle Unterschiede zu bedenken.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 2,
