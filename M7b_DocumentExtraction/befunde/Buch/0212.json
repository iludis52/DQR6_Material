      ],
      "quelle": "pp_doclayout",
      "text": "Die Befunde im Bereich prosozialen Verhaltens verdeutlichen sehr anschaulich, worin wesentliche Aufgaben der sozialen Neurowissenschaften liegen: einerseits nämlich in der Operationalisierung bestimmter Konstrukte, verbunden mit Fragen nach Reliabilität und Validität; andererseits in der Klärung von aktuellen Forschungsfragen aus der klassischen Sozialpsychologie.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 6,
      "query_id": 3,
      "pp_label": "text",
      "score": 0.9689918756484985,
      "bbox": {
        "x0": 109.33924865722656,
        "y0": 982.794189453125,
        "x1": 1014.473388671875,
        "y1": 1584.610107421875,
