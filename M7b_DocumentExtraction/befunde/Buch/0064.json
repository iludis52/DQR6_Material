    {
      "id": 10,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9661211371421814,
      "bbox": {
        "x0": 502.6326599121094,
        "y0": 1149.974853515625,
        "x1": 1408.196044921875,
        "y1": 1547.746826171875,
        "rahmen": "bild_pixel",
