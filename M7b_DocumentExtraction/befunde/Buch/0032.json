        "ursprung": "oben_links"
      },
      "lese_index": 251,
      "polygon": [
        [
          1056.0,
          985.0
        ],
        [
          1056.0,
          1070.0
        ],
        [
          1375.0,
          1070.0
        ],
        [
          1375.0,
          985.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Das Erleben kognitiver Dissonanz geht mit erhöhter physiologischer Erregung einher.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 12,
      "query_id": 6,
      "pp_label": "text",
      "score": 0.9153835773468018,
      "bbox": {
        "x0": 1057.0926513671875,
        "y0": 1252.099365234375,
        "x1": 1385.4893798828125,
        "y1": 1422.797607421875,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 262,
      "polygon": [
        [
          1057.0,
          1252.0
        ],
        [
          1057.0,
