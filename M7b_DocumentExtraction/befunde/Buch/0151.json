    {
      "id": 5,
      "query_id": 2,
      "pp_label": "text",
      "score": 0.964270830154419,
      "bbox": {
        "x0": 109.79188537597656,
        "y0": 682.2576904296875,
        "x1": 1014.3445434570312,
        "y1": 1183.7132568359375,
