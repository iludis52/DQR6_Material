      ],
      "quelle": "pp_doclayout",
      "text": "Demotion Allgemein bezeichnet Aggression das absichtliche Zufügen von Schaden oder Schmerz bei anderen Personen. Dabei beschreibt instrumentelle Aggression den Gebrauch von aggressivem Verhalten als ein Mittel, um ein anderes Ziel zu erreichen. Im Gegensatz dazu dient feindselige Aggression ausschließlich dazu, einer anderen Person zu schaden. Beide Formen von Aggression können sich verbal bzw. physisch oder direkt bzw. indirekt äußern.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
