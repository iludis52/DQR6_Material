      "quelle": "pp_doclayout",
      "text": "erste klassische Unterscheidung, die Ordnung in diese Vielfältigkeit bringt, ist die Unterscheidung zwischen intrinsischer und extrinsischer Religiosität.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 5,
