    },
    {
      "id": 5,
      "query_id": 0,
      "pp_label": "text",
      "score": 0.9710412621498108,
      "bbox": {
        "x0": 109.7869873046875,
        "y0": 449.1722717285156,
        "x1": 1014.107177734375,
        "y1": 981.710205078125,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 133,
      "polygon": [
        [
          109.0,
          449.0
        ],
        [
          117.0,
          980.0
        ],
        [
          1013.0,
