    {
      "id": 5,
      "query_id": 2,
      "pp_label": "text",
      "score": 0.9646927714347839,
      "bbox": {
        "x0": 109.21163940429688,
        "y0": 448.7139892578125,
        "x1": 1014.1298828125,
        "y1": 918.375,
        "rahmen": "bild_pixel",
