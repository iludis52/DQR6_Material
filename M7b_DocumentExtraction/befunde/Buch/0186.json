    {
      "id": 8,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9670572280883789,
      "bbox": {
        "x0": 109.67279052734375,
        "y0": 981.9794921875,
        "x1": 1014.2850341796875,
        "y1": 1550.87109375,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 152,
      "polygon": [
        [
          109.0,
