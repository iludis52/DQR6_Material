        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Ein Kind aus einem Fluss zu retten ist ein Beispiel für Hilfeverhalten, da es sich hier um eine Handlung gegenüber einer konkreten hilfsbedürftigen Person handelt.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 5,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9588161706924438,
      "bbox": {
        "x0": 503.8911437988281,
        "y0": 182.31295776367188,
        "x1": 1406.8369140625,
        "y1": 485.0350646972656,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 119,
      "polygon": [
        [
          503.0,
          182.0
        ],
        [
          503.0,
          484.0
        ],
        [
          1405.0,
          484.0
        ],
        [
          1405.0,
          182.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "erhielt. Bedeutend waren in diesem Zusammenhang natürlich der Friedensnobelpreis (1952) sowie die Prinz-Karl-Medaille für verdienstvolle humanitäre Betätigung (ebenfalls 1952). Insofern verkörpert Albert Schweitzer sehr anschaulich, was wir unter prosozialem (Hilfe-) Verhalten und Altruismus verstehen. Schön ist dabei, dass seine Biografie nicht derjenigen eines Heiligen gleichkommt – auch Schweitzer scheint bisweilen Schwierigkeiten gehabt zu haben, seine Ideen in aller Konsequenz umzusetzen; doch gerade dies macht ihn menschlich und für uns zu einem beeindruckenden Beispiel altruistischen Handelns, das sich durch sein gesamtes Leben zieht und sich nicht nur in seinen Taten, sondern auch in seinen geistigen Anschauungen äußert.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
