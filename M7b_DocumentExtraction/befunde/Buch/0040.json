    },
    {
      "id": 12,
      "query_id": 4,
      "pp_label": "text",
      "score": 0.9401353597640991,
      "bbox": {
        "x0": 504.824951171875,
        "y0": 649.4750366210938,
        "x1": 1405.8428955078125,
        "y1": 816.8732299804688,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 194,
      "polygon": [
        [
          504.0,
