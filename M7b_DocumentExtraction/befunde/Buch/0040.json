    {
      "id": 10,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9547262787818909,
      "bbox": {
        "x0": 503.89892578125,
        "y0": 249.826171875,
        "x1": 1406.139404296875,
        "y1": 517.5283203125,
        "rahmen": "bild_pixel",
