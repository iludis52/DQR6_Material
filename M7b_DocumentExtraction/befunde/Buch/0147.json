        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Sherifs Studien zum autokinetischen Effekt (Sherif, 1935) gehören zu den ersten und wohl einflussreichsten wissenschaftlichen Untersuchungen zum informativen sozialen Einfluss. Der autokinetische Effekt ist eine optische Täuschung, die immer dann auftritt, wenn das menschliche Auge keinen zweiten visuellen Referenzpunkt hat (▶ Studie: Sherifs Studien zum informationalen Gruppeneinfluss).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 7,
