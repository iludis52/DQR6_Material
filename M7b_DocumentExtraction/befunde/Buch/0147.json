      "quelle": "pp_doclayout",
      "text": "ben wirklich, dass diese korrekt ist. Diese Internalisierung (= innerliche Zustimmung) wird auch als private Akzeptanz (Konversion) bezeichnet. Hier kommt der informative soziale Einfluss zum Tragen, da die Versuchspersonen die Gruppe als nützliche und zuverlässige Informationsquelle betrachteten.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 3,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9575682282447815,
      "bbox": {
        "x0": 108.97077941894531,
        "y0": 316.62811279296875,
        "x1": 1014.5195922851562,
        "y1": 547.6504516601562,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 96,
      "polygon": [
        [
          116.0,
          316.0
        ],
        [
          108.0,
