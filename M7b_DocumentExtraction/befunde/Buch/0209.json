    {
      "id": 8,
      "query_id": 0,
      "pp_label": "text",
      "score": 0.9687001705169678,
      "bbox": {
        "x0": 504.0208740234375,
        "y0": 516.463134765625,
        "x1": 1407.7769775390625,
        "y1": 1115.461181640625,
        "rahmen": "bild_pixel",
