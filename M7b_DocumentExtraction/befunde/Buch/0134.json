        ],
        [
          1007.0,
          1882.0
        ],
        [
          117.0,
          1882.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Die Gruppe kann aber auch ausschließlich einen Einfluss auf die eigene Leistung haben. So konnte Triplett (1898) zeigen, dass die Gegenwart anderer dazu führen kann,",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
