        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Ein positiver Effekt von Gruppen kann sein, dass sich Gruppenmitglie- der besser fühlen wegen der besonders guten Leistung ihrer eigenen Gruppe (»basking in reflected glory«).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 15,
      "query_id": 10,
