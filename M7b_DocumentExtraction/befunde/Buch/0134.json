      ],
      "quelle": "pp_doclayout",
      "text": "losung.\nInformationaler Einfluss von Gruppen ist somit gekennzeichnet durch die Motivation, zu korrekten Einstellungen und Wahrnehmungen zu gelangen (Deutsch & Gerard, 1955; Kelley, 1952). Normativer sozialer Einfluss ist dagegen gekennzeichnet durch den Wunsch nach sozialer Anerkennung und die Vermeidung negativer Sanktionen durch die Gruppe (z. B. Allen, 1965; Crutchfield, 1962; Nail, 1986).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 5,
      "query_id": 8,
      "pp_label": "paragraph_title",
      "score": 0.8706429600715637,
      "bbox": {
        "x0": 111.93942260742188,
        "y0": 473.8988037109375,
        "x1": 579.7855224609375,
        "y1": 510.79638671875,
