        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Ist die Verarbeitung selbstbezogener Information dagegen mit emotionaler Valenz verbunden, so sind andere kortikale bzw. subkortikale Areale aktiviert. (z. B. vACC, Insula).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
