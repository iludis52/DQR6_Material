        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Viele Hirnareale, die bei der Verarbeitung selbstbezogener Information aktiviert sind, zeigen auch Aktivität bei der Wahrnehmung anderer Personen.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
