      "quelle": "pp_doclayout",
      "text": "Wird die emotionale Valenz kontrolliert, so zeigt sich für die Verarbeitung selbstbezogener Information Aktivität im Bereich des mPFC.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
