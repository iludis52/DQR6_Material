        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Die Verarbeitung selbstbezogener Information (im Gegensatz zu Information ohne Eigenbezug) führt zu speziellen Aktivitätsmustern. Dabei kann nach unterschiedlichen Prozessen innerhalb des Selbst unterschieden werden.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 5,
