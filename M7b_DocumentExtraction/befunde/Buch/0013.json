          453.0,
          1752.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Die europäische Sozialpsychologie befasst sich stark mit Gruppenphänomenen, während die amerikani-sche Sozialpsychologie stärker auf individuelle Aspekte menschlichen Erlebens und Verhaltens fokussiert.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 9,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9652990698814392,
      "bbox": {
        "x0": 503.5449523925781,
        "y0": 1249.75390625,
        "x1": 1406.17236328125,
        "y1": 1614.74560546875,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 259,
      "polygon": [
        [
