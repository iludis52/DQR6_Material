        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Im Free-Choice-Paradigma wird Dissonanz durch das Treffen einer Entscheidung erzeugt. Diese Dissonanz wird reduziert, indem die gewählte Entscheidungs- alternative aufgewertet und die nicht gewählte Alternative ab- gewertet wird (»spreading apart of alternatives«). Der Effekt ist umso stärker, je schwieriger die Entscheidung ist bzw. je ähnlicher sich die beiden Entscheidungs- alternativen sind (hohes Ausmaß erlebter Dissonanz).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
