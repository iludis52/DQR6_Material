        "x1": 1013.2473754882812,
        "y1": 649.4931640625,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 89,
      "polygon": [
        [
          110.0,
          260.0
        ],
