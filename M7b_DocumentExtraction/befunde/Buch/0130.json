        ]
      ],
      "quelle": "pp_doclayout",
      "text": "die Theorie der sozialen Identität auch dazu in der Lage, einen wichtigen Beitrag zum Verständnis von Krieg und Gewalt unter verschiedenen Gruppen zu leisten (vgl. Haslam, 2004).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 4,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9626836180686951,
      "bbox": {
        "x0": 110.07495880126953,
        "y0": 282.7858581542969,
        "x1": 1014.1693115234375,
        "y1": 584.04833984375,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 82,
      "polygon": [
        [
