    {
      "id": 8,
      "query_id": 2,
      "pp_label": "text",
      "score": 0.9673669934272766,
      "bbox": {
        "x0": 109.60497283935547,
        "y0": 1149.2628173828125,
        "x1": 1013.63916015625,
        "y1": 1582.5184326171875,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 142,
      "polygon": [
        [
