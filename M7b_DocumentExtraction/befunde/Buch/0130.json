        ],
        [
          1376.0,
          285.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Entscheidend an der Theorie der sozialen Identität ist, dass sowohl das Individuum, die Gruppe als auch die Interaktion aus beiden Komponenten als Analyseeinheiten betrachtet werden.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
