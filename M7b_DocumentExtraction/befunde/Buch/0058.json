        ],
        [
          407.0,
          1786.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Der Bystander-Effekt ist auch in einfachen Hilfesituationen zu beobachten.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
