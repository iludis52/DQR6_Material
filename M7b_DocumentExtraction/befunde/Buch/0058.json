        ],
        [
          128.0,
          1348.0
        ],
        [
          447.0,
          1348.0
        ],
        [
          447.0,
          1153.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Die Angst vor Blamage oder negativer Beurteilung durch andere, die sog. »Bewertungsangst«, reduziert die Wahrscheinlichkeit zur Hilfe-leistung. Mangelndes Wissen um adäquate Hilfeleistung kann Bewertungsangst verstärken.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 10,
