        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Verantwortungsdiffusion beschreibt die Tendenz, die allgemeine Verantwortung auf alle Anwesenden aufzuteilen. Erhöht sich deren An- zahl, verringert sich die subjektiv wahrgenommene Verantwortlichkeit des Einzelnen und die Wahrschein- lichkeit zur Hilfeleistung sinkt.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 9,
      "query_id": 10,
      "pp_label": "text",
      "score": 0.9416158199310303,
      "bbox": {
        "x0": 128.5350799560547,
        "y0": 1153.384765625,
        "x1": 448.1840515136719,
        "y1": 1349.201171875,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 198,
      "polygon": [
        [
          128.0,
