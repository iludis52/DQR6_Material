        ],
        [
          456.0,
          1485.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "In typischen Studien zum Bystander-Effekt bearbeiten Personen entweder allein oder zusammen mit anderen (Bystander-Bedingung) eine irrelevante Aufgabe, wenn sich ein Notfall ereignet. Abhängige Variable ist, ob, wann und wie die Person eingreift. Klassischerweise wird in der Bystander-Bedingung seltener und später geholfen.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 11,
