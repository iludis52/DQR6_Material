          1682.0
        ],
        [
          557.0,
          1682.0
        ],
        [
          511.0,
          1682.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Der Bystander-Effekt tritt jedoch nicht nur in Notfallsituationen auf, in denen das Opfer oder auch die Bystander selbst in Gefahr sind; er zeigt sich auch in einfachen Hilfesituationen, etwa wenn es darum geht, einer anderen Person die Tür aufzumachen (Levy et al., 1972). Ebenso konnte er in Situationen mit juristischem Inhalt beobachtet werden, in denen ein Täter eine Straftat begeht (z. B. Diebstahl von Geld; Latané & Elman, 1970).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 17,
      "query_id": 6,
      "pp_label": "text",
