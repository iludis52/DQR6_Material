    },
    {
      "id": 5,
      "query_id": 4,
      "pp_label": "text",
      "score": 0.9588215947151184,
      "bbox": {
        "x0": 110.05810546875,
        "y0": 883.1712036132812,
        "x1": 1012.9774169921875,
        "y1": 1149.656005859375,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 111,
      "polygon": [
        [
          118.0,
