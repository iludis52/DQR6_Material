      ],
      "quelle": "pp_doclayout",
      "text": "Zivilcourage bedeutet, Hilfeverhalten auch dann zu zeigen, wenn das Einschreiten mit erheblichen physischen, psychischen und sozialen Folgen verbunden sein kann.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 8,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9638069272041321,
      "bbox": {
        "x0": 109.76832580566406,
        "y0": 1349.06982421875,
        "x1": 1013.1102294921875,
        "y1": 1716.59521484375,
