        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Entgegen der weit verbreiteten Erwartung führt gerade hoher (und nicht so sehr niedriger) Selbst-wert nach Frustration häufig zu Aggression.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
