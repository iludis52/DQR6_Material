        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Biologische Erklärungsansätze betrachten auch neurochemische und hirnphysiologische Korrelate von Aggression. Hier spielen die Amygdala, der Neuro-transmitter Serotonin sowie das Hormon Testosteron eine besondere Rolle.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
