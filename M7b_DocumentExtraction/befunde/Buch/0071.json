      "quelle": "pp_doclayout",
      "text": "Der biologische Ansatz geht davon aus, dass aggressives Verhalten einen »Fitness-Vorteil« in der evolutionären Selektion erbracht hat.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
