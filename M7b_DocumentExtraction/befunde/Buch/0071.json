        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Gemäß der Katharsishypothese (griech. »katharsis« = Reinigung) führt das Ausleben bzw. die Entladung bestimmter Gefühlszustände (z. B. Aggression) zu einer Reduktion derselben.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
