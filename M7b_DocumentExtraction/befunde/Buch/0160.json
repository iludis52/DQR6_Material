        ]
      ],
      "quelle": "pp_doclayout",
      "text": "3. Positive Emotionen verändern das Denken in Krisensituationen. Sie erweitern den Aufmerksamkeitsfokus und dadurch auch das Verhaltensrepertoire (Fredrickson, 2000).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
