        [
          1011.0,
          883.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "I'm wirtschaftlichen Handeln kann diese unterschiedliche Wirkung von Gewinnen und Verlusten bzw. entsprechende Risikobereitschaft häufig am Aktienmarkt beobachtet werden: Wenn Personen durch riskante Investitionen finanzielle Verluste erlitten haben, werden sie häufig risikofreudiger (d. h. sie investieren noch mehr Geld in riskante Geldanalagen), um diesen Verlust wieder auszugleichen. Nicht selten endet dies mit einem kompletten Verlust der Geldanlagen.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
