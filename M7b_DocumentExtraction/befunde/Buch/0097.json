      "quelle": "pp_doclayout",
      "text": "6.4.1 Einstellungsänderung als Rationalisierung von Verhalten",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
