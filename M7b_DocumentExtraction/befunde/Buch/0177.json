      "ausschnitt": null
    },
    {
      "id": 7,
      "query_id": 2,
      "pp_label": "text",
      "score": 0.9623029232025146,
      "bbox": {
        "x0": 503.60211181640625,
        "y0": 415.4615783691406,
        "x1": 1405.9127197265625,
        "y1": 885.6617431640625,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 138,
      "polygon": [
        [
          503.0,
