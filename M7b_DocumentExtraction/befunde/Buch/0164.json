          1377.0,
          1652.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Ein hohes Selbstwertgefühl wirkt als weiterer »Angstpuffer« bzgl. der eigenen Sterblichkeit: Es reduziert todesbezogene Ängste und kann auch zukünftig vor diesen schützen.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    }
  ],
