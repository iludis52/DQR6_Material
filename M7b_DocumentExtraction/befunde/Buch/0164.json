    {
      "id": 10,
      "query_id": 3,
      "pp_label": "text",
      "score": 0.961911141872406,
      "bbox": {
        "x0": 109.67559814453125,
        "y0": 1381.92578125,
        "x1": 1013.4542846679688,
        "y1": 1618.48974609375,
        "rahmen": "bild_pixel",
