        [
          1388.0,
          1573.0
        ],
        [
          1388.0,
          1434.0
        ],
        [
          1381.0,
          1384.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Eine kulturelle Weltsicht bzw. kulturelle Glaubenssysteme schaffen Struktur, indem sie bestimmte Werte, Standards oder die Hoffnung auf Unsterblichkeit vermitteln. Die Orientierung daran gibt Sicherheit und verringert die Angst vor dem Tod.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 15,
