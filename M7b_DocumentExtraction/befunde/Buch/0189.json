      "pp_label": "text",
      "score": 0.9113297462463379,
      "bbox": {
        "x0": 128.970703125,
        "y0": 1485.30810546875,
        "x1": 458.6054992675781,
        "y1": 1627.23193359375,
        "rahmen": "bild_pixel",
