        ]
      ],
      "quelle": "pp_doclayout",
      "text": "2. Die Durchsetzbarkeit entsprechender Regelungen ist schwierig, da Verstöße oft unentdeckt bleiben und angekündigte Strafen nicht zwangsläufig verhängt werden.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
