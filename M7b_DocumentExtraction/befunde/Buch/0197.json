        ],
        [
          1407.0,
          182.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "welche Aktivierung wird dabei erfasst? Diesen Fragen möchten wir im Folgenden auf den Grund gehen, wobei wir nicht das Ziel verfolgen, einen umfassenden Einblick in die technischen Grundlagen der Kernspintomografie zu geben – dazu könnte man ein gesamtes Buch schreiben; vielmehr geht es darum, Ihnen einen Eindruck darüber zu vermitteln, was mit diesem Verfahren überhaupt gemessen wird.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 6,
      "query_id": 2,
      "pp_label": "text",
      "score": 0.9576584696769714,
      "bbox": {
        "x0": 503.7602233886719,
        "y0": 350.2493896484375,
        "x1": 1407.7685546875,
        "y1": 617.0087890625,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 144,
      "polygon": [
