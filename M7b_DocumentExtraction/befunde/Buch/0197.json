      ],
      "quelle": "pp_doclayout",
      "text": "MRT-Messungen werden in einem Magnetresonanztomografen bzw. im sog. »Scanner« durchgeführt. Von diesem geht ein extrem starkes Mag-netfeld (meist 1,5 bzw. 3 Tesla) aus.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
