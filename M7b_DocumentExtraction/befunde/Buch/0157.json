      "pp_label": "text",
      "score": 0.9502456188201904,
      "bbox": {
        "x0": 503.73284912109375,
        "y0": 181.96121215820312,
        "x1": 1406.3359375,
        "y1": 314.9810485839844,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 160,
      "polygon": [
        [
          503.0,
