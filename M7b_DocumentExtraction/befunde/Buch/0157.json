        [
          451.0,
          1487.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Der Zusammenhang zwischen Kör- per und Geist ist zentral bei der Behandlung von Krankheiten. Daher wirken sog. Resilienzfaktoren, die die emotionale Stabilität und Widerstandsfähigkeit erhöhen, Erkrankungen präventiv entgegen.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 5,
