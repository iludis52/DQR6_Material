        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Neben biologischen sind auch psy-chologische und soziale Faktoren zentral für unsere psychische und physische Gesundheit. Insofern liegt der Einfluss der Psychologie hier auf der Hand.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
