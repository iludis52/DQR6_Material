    {
      "id": 8,
      "query_id": 2,
      "pp_label": "text",
      "score": 0.9602552056312561,
      "bbox": {
        "x0": 504.1820068359375,
        "y0": 682.705322265625,
        "x1": 1405.9583740234375,
        "y1": 1014.98828125,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 193,
      "polygon": [
