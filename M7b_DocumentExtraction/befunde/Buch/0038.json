      "bbox": {
        "x0": 544.8743286132812,
        "y0": 615.6926879882812,
        "x1": 1362.4547119140625,
        "y1": 683.0614624023438,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 193,
      "polygon": [
