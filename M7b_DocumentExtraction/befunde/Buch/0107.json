      "pp_label": "text",
      "score": 0.9655664563179016,
      "bbox": {
        "x0": 110.02748107910156,
        "y0": 283.509521484375,
        "x1": 1014.2352905273438,
        "y1": 649.50537109375,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 92,
