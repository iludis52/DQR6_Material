        [
          1384.0,
          1087.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Für eine Abnahme von Vorurteilen spricht z. B., dass die ethnische Herkunft bei der Stellenvergabe weniger bedeutsam ist und in den Medien seltener Anlass für Stereotype bietet. Zudem haben die Stereotype und Vorurteile weißer gegenüber dunkel-häutiger Amerikaner abgenommen.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 12,
