        [
          1366.0,
          784.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Bestimmte Vorurteile in der Gesellschaft sind offensichtlich auf dem Rückzug. Fraglich ist aber, ob dem tatsächlich so ist oder ob es nur so scheint.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 11,
      "query_id": 8,
      "pp_label": "text",
