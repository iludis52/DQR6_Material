        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Beim Waffeneffekt handelt es sich um einen robusten und generalisierbaren Befund, der nicht an ein bestimmtes experimentelles Vorgehen gebunden ist; stattdessen tritt der Waffeneffekt bei unterschiedlichen Gegenständen (Pistole, Messer etc.),",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
