      ],
      "quelle": "pp_doclayout",
      "text": "Instrumentelle Aggression\ndient der Erreichung eines bestimm-\nten Ziels (z. B. Krieg). Feindselige Aggression ist dagegen nicht ziel-\ngerichtet und dient nur dem Zufügen von Schaden und/oder Schmerz (z. B. Rache).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 6,
      "query_id": 10,
      "pp_label": "text",
      "score": 0.8423993587493896,
      "bbox": {
