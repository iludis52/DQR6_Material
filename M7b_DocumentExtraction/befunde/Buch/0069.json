        ]
      ],
      "quelle": "pp_doclayout",
      "text": "Ein zentraler Bestandteil moderner Aggressionsdefinitionen beinhaltet die Willensabsicht, jemand anderem Schaden zuzufügen. Schädigendes Verhalten, das nicht intentional ist, kann somit nicht als Aggression bezeichnet werden (s. auch den Unterschied in der Rechtsprechung hinsichtlich Totschlag vs. Mord).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
