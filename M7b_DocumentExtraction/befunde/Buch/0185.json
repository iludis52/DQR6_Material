      ],
      "quelle": "pp_doclayout",
      "text": "Solange verinnerlichte soziale Normen nur im Menschen schlummern, haben sie keinerlei Auswirkungen. Um tatsächlich kooperatives Verhalten in Gang setzen zu können, müssen sie aktiviert werden und ins Bewusstsein gelangen. Hierbei spielen ganz unterschiedliche Kontextfaktoren eine entscheidende Rolle. Einige seien im Folgenden erwähnt.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
