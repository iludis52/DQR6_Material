      "quelle": "pp_doclayout",
      "text": "Kooperatives Verhalten setzt die Aktivierung dieser sozialen Normen im Bewusstsein voraus. Hierbei sind verschiedene Kontextfaktoren entscheidend:",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
