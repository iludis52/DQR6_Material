        [
          512.0,
          483.0
        ]
      ],
      "quelle": "pp_doclayout",
      "text": "1. Menschen können kooperieren, wenn sie dies als ihre moralische Pflicht empfinden (Kant, 1785/2004; Krueger, Massey & DiDionato, 2008).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 11,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9501932859420776,
      "bbox": {
        "x0": 505.1134033203125,
        "y0": 550.472900390625,
        "x1": 1407.0885009765625,
        "y1": 746.08642578125,
        "rahmen": "bild_pixel",
