      "quelle": "pp_doclayout",
      "text": "Bei salienter sozialer Identität und dem Zustand der Depersonalisierung kann es zur Selbststereotypisierung kommen.",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
