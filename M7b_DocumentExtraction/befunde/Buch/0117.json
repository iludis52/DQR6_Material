      ],
      "quelle": "pp_doclayout",
      "text": "60% der dunkelhäutigen Befragten an, dass sie oft (bzw. sehr oft) von weißen Ärzten diskriminiert würden. Und was die Gleichstellung der Geschlechter betrifft, so ist der männliche Anteil in höheren Führungspositionen trotz Emanzipation und Bemühungen zur Geschlechtergleichheit nach wie vor wesentlich höher als derjenige von Frauen (Eagly & Karau, 2002).",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
      "ausschnitt": null
    },
    {
      "id": 4,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.965016782283783,
      "bbox": {
        "x0": 110.9996109008789,
        "y0": 350.581298828125,
        "x1": 1013.8021850585938,
        "y1": 645.7418212890625,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 59,
      "polygon": [
