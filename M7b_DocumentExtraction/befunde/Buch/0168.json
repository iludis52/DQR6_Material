    {
      "id": 5,
      "query_id": 2,
      "pp_label": "text",
      "score": 0.9586520195007324,
      "bbox": {
        "x0": 110.62285614013672,
        "y0": 582.1932373046875,
        "x1": 1012.41748046875,
        "y1": 814.8287353515625,
        "rahmen": "bild_pixel",
