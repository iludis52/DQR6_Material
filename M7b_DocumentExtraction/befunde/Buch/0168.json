      "quelle": "pp_doclayout",
      "text": "10.3.1 Religion im Gruppenkontext – Abwertung der Fremdgruppe",
      "text_format": "klartext",
      "text_quelle": "paddleocr_vl",
      "zusammengefuehrt_aus": null,
