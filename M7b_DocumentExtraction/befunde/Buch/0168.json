    {
      "id": 9,
      "query_id": 1,
      "pp_label": "text",
      "score": 0.9715802669525146,
      "bbox": {
        "x0": 110.05992126464844,
        "y0": 1382.0675048828125,
        "x1": 1013.1602172851562,
        "y1": 1846.9210205078125,
        "rahmen": "bild_pixel",
        "ursprung": "oben_links"
      },
      "lese_index": 184,
      "polygon": [
        [
